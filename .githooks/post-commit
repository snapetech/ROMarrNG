#!/usr/bin/env bash
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
sync_script="$repo_root/scripts/sync-yunohost-package.sh"

if [[ ! -f "$sync_script" ]]; then
	echo "YunoHost package sync script not found: $sync_script" >&2
	exit 1
fi

if bash "$sync_script"; then
	exit 0
else
	status=$?
	echo "YunoHost package sync failed (exit $status)." >&2
	exit "$status"
fi
